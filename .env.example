# Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
CHROMA_DIR=.local/chroma
SQLITE_PATH=.local/researchmind.sqlite3
EMBEDDING_CACHE_PATH=.local/embedding_cache.sqlite3
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
EMBEDDING_OUTPUT_DIMENSIONALITY=768
EMBEDDING_MAX_ATTEMPTS=5
OCR_LANGUAGE=por+eng
MAX_RESEARCH_ITERATIONS=3
